# Copy to .env. Every tunable in src/config.ts can be set here.
CLUSTER=mainnet-beta
RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC (Helius/Triton) in production
# Hot wallet keypair JSON (never commit it). Not needed for --dry-run if KEEPER_PUBKEY is set.
KEEPER_KEYPAIR=
KEEPER_PUBKEY=
# Set after launching POD5 on orcapod.fun
POD5_MINT=
# POD5 pool, deployer, Pod platform + treasury wallets (comma separated)
EXCLUDE_WALLETS=A8rgwWAfFZvCwSEjjp2KrWBeoczBGTK7c3jLyztF56Vq,HpiwS7SXx2eaS5fUxnp2UQT9FwYupnLvqxMw3S8w3btQ
EXCLUDE_MINTS=
DB_PATH=./data/keeper.db
PUBLISH_DIR=../web/public/data
POT_CAP_SOL=0.2
ALERT_WEBHOOK_URL=
