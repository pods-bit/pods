# Where the keeper publishes state.json and owed.json (relative to the site, or an absolute URL).
VITE_DATA_BASE=./data
# Browser-friendly Solana RPC. The public api.mainnet-beta.solana.com answers 403 to browser origins,
# so set a provider URL here (domain-restricted key) for the live "Fees waiting" number and the wallet checker.
VITE_RPC_URL=https://api.mainnet-beta.solana.com
